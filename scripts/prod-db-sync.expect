#!/usr/bin/expect -f

set timeout [lindex $argv 0]
set command [lrange $argv 1 end]
set password $env(PROD_DB_SYNC_PASSWORD)

spawn {*}$command

expect {
  -re "(?i)are you sure you want to continue connecting" {
    send "yes\r"
    exp_continue
  }
  -re "(?i)password:" {
    send "$password\r"
    exp_continue
  }
  eof {
    catch wait result
    set exit_code [lindex $result 3]
    exit $exit_code
  }
}
