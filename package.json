{
  "name": "novell-reader",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "pnpm --filter @novell-reader/shared build && pnpm --filter @novell-reader/server prisma:generate",
    "typecheck": "pnpm codegen && pnpm -r typecheck",
    "test": "pnpm codegen && pnpm -r test",
    "build": "pnpm codegen && pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @novell-reader/server dev",
    "dev:miniapp": "pnpm --filter @novell-reader/miniapp dev",
    "import:epub": "pnpm --filter @novell-reader/server import:epub",
    "start:prod": "pnpm --filter @novell-reader/server exec prisma db push && pnpm import:epub && node apps/server/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
